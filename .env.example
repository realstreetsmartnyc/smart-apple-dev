# smart-apple-dev environment variables
# Copy this file to .env and fill in your values.

# === LLM Agent ===
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
OLLAMA_URL=http://localhost:11434

# === App Store Connect (fastlane) ===
# FASTLANE_USER=you@example.com
# FASTLANE_PASSWORD=your-app-specific-password
# APP_STORE_CONNECT_API_KEY_ID=ABC123XYZ
# APP_STORE_CONNECT_API_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_CONNECT_API_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
